{
  "name": "imagemitten",
  "displayName": "MittenIMG",
  "description": "Generates images based on codebase context using Pollinations API and LLM prompt enhancement.",
  "version": "0.0.1",
  "icon": "media/logo.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "MittenIMG",
      "properties": {
        "imagemitten.useCodebaseContext": {
          "type": "boolean",
          "default": true,
          "description": "Whether to use codebase context and LLM to enhance the prompt before generating the image. If disabled, prompt is sent directly as typed."
        },
        "imagemitten.pollinationsApiKey": {
          "type": "string",
          "default": "",
          "description": "Pollinations API Key for LLM Prompt Enhancement and Image Generation"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "imagemitten-sidebar",
          "title": "MittenIMG",
          "icon": "media/icon-activitybar.png"
        }
      ]
    },
    "views": {
      "imagemitten-sidebar": [
        {
          "type": "webview",
          "id": "imagemitten-sidebar.view",
          "name": "Generate Images"
        }
      ]
    },
    "commands": [
      {
        "command": "imagemitten.start",
        "title": "Start MittenIMG"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.125.0",
    "eslint": "^10.0.1",
    "glob": "^8.0.3",
    "globals": "^17.9.0",
    "mocha": "^10.1.0",
    "ts-loader": "^9.4.2",
    "typescript": "^4.9.3",
    "typescript-eslint": "^8.66.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "overrides": {
    "serialize-javascript": "^7.1.0"
  }
}
